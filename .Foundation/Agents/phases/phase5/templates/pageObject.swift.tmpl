import XCTest

/// Page object for {{VIEW_NAME}} screen
/// Encapsulates element access and common interactions
class {{VIEW_NAME}}Page {

    // MARK: - Properties

    let app: XCUIApplication

    // MARK: - Initialization

    init(app: XCUIApplication) {
        self.app = app
    }

    // MARK: - Elements

    /// {{ELEMENT_DESCRIPTION}}
    var {{ELEMENT_NAME}}: XCUIElement {
        app.buttons["{{IDENTIFIER}}"]
    }

    /// Navigation bar title
    var navigationTitle: XCUIElement {
        app.navigationBars.staticTexts["{{VIEW_NAME}}"]
    }

    /// Loading indicator
    var loadingIndicator: XCUIElement {
        app.activityIndicators.firstMatch
    }

    /// Error message label
    var errorMessage: XCUIElement {
        app.staticTexts["error-message"]
    }

    // MARK: - Element Collections

    /// All buttons on this page
    var allButtons: XCUIElementQuery {
        app.buttons
    }

    /// All text fields on this page
    var allTextFields: XCUIElementQuery {
        app.textFields
    }

    // MARK: - Actions

    /// Tap on {{ELEMENT_NAME}}
    func tap{{ELEMENT_NAME}}() {
        {{ELEMENT_NAME}}.tap()
    }

    /// Enter text in a field
    func enterText(_ text: String, in field: XCUIElement) {
        field.tap()
        field.typeText(text)
    }

    /// Clear and enter text
    func clearAndEnterText(_ text: String, in field: XCUIElement) {
        field.tap()
        if let existingText = field.value as? String, !existingText.isEmpty {
            let deleteString = String(repeating: XCUIKeyboardKey.delete.rawValue, count: existingText.count)
            field.typeText(deleteString)
        }
        field.typeText(text)
    }

    /// Scroll to element
    func scrollTo(_ element: XCUIElement) {
        while !element.isHittable {
            app.swipeUp()
        }
    }

    // MARK: - Verifications

    /// Verify page is displayed
    func verifyPageDisplayed(timeout: TimeInterval = 5) -> Bool {
        navigationTitle.waitForExistence(timeout: timeout)
    }

    /// Verify {{ELEMENT_NAME}} exists
    func verify{{ELEMENT_NAME}}Exists(timeout: TimeInterval = 5) -> Bool {
        {{ELEMENT_NAME}}.waitForExistence(timeout: timeout)
    }

    /// Verify loading is complete
    func verifyLoadingComplete(timeout: TimeInterval = 10) -> Bool {
        // Wait for loading indicator to disappear
        let expectation = XCTNSPredicateExpectation(
            predicate: NSPredicate(format: "exists == false"),
            object: loadingIndicator
        )
        let result = XCTWaiter().wait(for: [expectation], timeout: timeout)
        return result == .completed
    }

    /// Verify error is displayed
    func verifyErrorDisplayed(timeout: TimeInterval = 5) -> Bool {
        errorMessage.waitForExistence(timeout: timeout)
    }

    /// Get error message text
    func getErrorMessageText() -> String? {
        guard errorMessage.exists else { return nil }
        return errorMessage.label
    }

    // MARK: - Wait Helpers

    /// Wait for element to exist
    @discardableResult
    func waitForElement(_ element: XCUIElement, timeout: TimeInterval = 5) -> Bool {
        element.waitForExistence(timeout: timeout)
    }

    /// Wait for element to be hittable
    @discardableResult
    func waitForElementHittable(_ element: XCUIElement, timeout: TimeInterval = 5) -> Bool {
        let predicate = NSPredicate(format: "isHittable == true")
        let expectation = XCTNSPredicateExpectation(predicate: predicate, object: element)
        let result = XCTWaiter().wait(for: [expectation], timeout: timeout)
        return result == .completed
    }

    // MARK: - Navigation

    /// Navigate back
    func navigateBack() {
        app.navigationBars.buttons.firstMatch.tap()
    }

    /// Dismiss modal
    func dismissModal() {
        app.buttons["Close"].tap()
    }
}

// MARK: - Page Object Protocol

/// Protocol for page objects to conform to
protocol PageObject {
    var app: XCUIApplication { get }
    init(app: XCUIApplication)
    func verifyPageDisplayed(timeout: TimeInterval) -> Bool
}

extension {{VIEW_NAME}}Page: PageObject {}
